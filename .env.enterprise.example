# Run `python -m service.manage init` to generate random local secrets.
IT_JWT_SECRET=
IT_METRICS_TOKEN=
IT_ORIGIN=http://127.0.0.1:8600
IT_COOKIE_SECURE=false
# Optional durable shared state and pgvector storage; leave unset for local SQLite/Chroma.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
IT_MAX_ACTIVE_CHATS=4
# Defaults reuse ZHIPUAI_API_KEY and SILICONFLOW_API_KEY from .env.
# Set these only when migrating to a verified OpenAI-compatible provider/model.
# IT_CHAT_URL=https://open.bigmodel.cn/api/paas/v4/
# IT_CHAT_MODEL=glm-4-flash
# IT_CHAT_KEY=
# IT_EMBED_URL=https://api.siliconflow.cn/v1
# IT_EMBED_MODEL=BAAI/bge-m3
# IT_EMBED_KEY=

# Show shared employee/admin credentials on the demo login page.
IT_DEMO_LOGIN=false

# Optional SiliconFlow reranker. Keep disabled until your own corpus evaluation improves.
IT_RERANK_ENABLED=false
IT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
IT_RERANK_THRESHOLD=0.25
